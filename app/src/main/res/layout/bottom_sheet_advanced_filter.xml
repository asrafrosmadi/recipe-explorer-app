<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:text="Advanced Filters"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/advancedFilterContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </ScrollView>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--<com.google.android.material.button.MaterialButton
            android:id="@+id/resetFilterBtn"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Reset"
            android:textColor="@color/primary"
            app:backgroundTint="@android:color/transparent"
            android:background="@drawable/bg_reset_btn"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyFilterBtn"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Apply"
            android:textColor="@android:color/white"
            app:backgroundTint="@android:color/transparent"
            android:background="@drawable/bg_apply_btn"/>-->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/resetFilterBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="45dp"
            android:text="Reset"
            android:textColor="@color/primary"
            android:background="@drawable/bg_reset_btn"
            android:backgroundTint="@null"
            android:layout_marginEnd="5dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/applyFilterBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="45dp"
            android:text="Apply"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_apply_btn"
            android:backgroundTint="@null"
            android:layout_marginStart="5dp"/>

    </LinearLayout>

</LinearLayout>